+/// JP masterdata 中与 WL3 终章 #218 相关的真实行（另含对照活动 180/214/217）。
+struct JpFinaleRows {
+    events: Vec<types::Event>,
+    world_blooms: Vec<types::WorldBloom>,
+    card_bonus_limits: Vec<types::EventCardBonusLimit>,
+    skill_limits: Vec<types::EventSkillScoreUpLimit>,
+    shuffle_bonuses: Vec<types::EventShuffleUnitBonus>,
+}
+
+fn jp_finale_rows() -> JpFinaleRows {
+    let event = |id: i32, event_type: &str| types::Event {
+        id,
+        event_type: event_type.to_string(),
+    };
+    let world_bloom =
+        |event_id: i32, character: Option<i32>, chapter_type: &str| types::WorldBloom {
+            event_id,
+            game_character_id: character,
+            chapter_no: 1,
+            world_bloom_chapter_type: Some(chapter_type.to_string()),
+        };
+    let shuffle = |unit_count: i32, bonus_rate: i32| types::EventShuffleUnitBonus {
+        event_id: 218,
+        unit_count,
+        bonus_rate,
+    };
+    JpFinaleRows {
+        events: vec![
+            event(180, "world_bloom"),
+            event(214, "world_bloom"),
+            event(217, "marathon"),
+            event(218, "world_bloom"),
+        ],
+        world_blooms: vec![
+            world_bloom(180, None, "finale"),
+            world_bloom(214, Some(11), "game_character"),
+            world_bloom(218, None, "finale"),
+        ],
+        card_bonus_limits: vec![types::EventCardBonusLimit {
+            event_id: 180,
+            member_count_limit: 4,
+        }],
+        skill_limits: vec![types::EventSkillScoreUpLimit {
+            event_id: 218,
+            score_up_limit: 140,
+        }],
+        shuffle_bonuses: vec![shuffle(3, 10), shuffle(4, 30), shuffle(5, 50)],
+    }
+}
+
+fn jp_finale_game<'a>(rows: &'a JpFinaleRows, base: GameData<'a>) -> GameData<'a> {
+    GameData {
+        events: &rows.events,
+        world_blooms: &rows.world_blooms,
+        event_card_bonus_limits: &rows.card_bonus_limits,
+        event_skill_score_up_limits: &rows.skill_limits,
+        event_shuffle_unit_bonuses: &rows.shuffle_bonuses,
+        ..base
+    }
+}
+
+#[test]
+fn jp_finale_218_resolves_finale_rules_from_masterdata() {
+    let rows = jp_finale_rows();
+    let game = jp_finale_game(
+        &rows,
+        sample_game(&[], &[], &[], &[], &[], &[], &[], &[], &[]),
+    );
+    let context = |event_id: i32, live_type: LiveType| {
+        let params = BuildParams {
+            event_id: Some(event_id),
+            live_type,
+            ..BuildParams::default()
+        };
+        super::event_bonus::build_event_context(&game, &params)
+            .expect("活动上下文应能构建")
+            .expect("真实活动应有活动上下文")
+    };
+
+    // 218：worldBlooms 行为 finale，技能上限表值 140 即效果上限，5 人享受加成。
+    let finale = context(218, LiveType::Multi);
+    assert!(finale.is_finale);
+    assert_eq!(finale.skill_score_up_limit, Some(140));
+    assert_eq!(finale.card_bonus_count_limit, 5);
+    assert_eq!(finale.shuffle_unit_bonus, [0, 0, 0, 10, 30, 50]);
+    assert_eq!(finale.world_bloom_character_id, None);
+    assert_eq!(context(218, LiveType::Solo).skill_score_up_limit, Some(140));
+    assert_eq!(context(218, LiveType::Challenge).skill_score_up_limit, None);
+
+    // 180：表内 4 人，技能上限走终章兜底 140，无 shuffle 加成。
+    let legacy = context(180, LiveType::Multi);
+    assert!(legacy.is_finale);
+    assert_eq!(legacy.skill_score_up_limit, Some(140));
+    assert_eq!(legacy.card_bonus_count_limit, 4);
+    assert_eq!(legacy.shuffle_unit_bonus, [0; 6]);
+
+    // WL3 普通章节与普通活动不受影响。
+    for event_id in [214, 217] {
+        let ctx = context(event_id, LiveType::Multi);
+        assert!(!ctx.is_finale, "event {event_id}");
+        assert_eq!(ctx.skill_score_up_limit, None, "event {event_id}");
+        assert_eq!(ctx.card_bonus_count_limit, 5, "event {event_id}");
+        assert_eq!(ctx.shuffle_unit_bonus, [0; 6], "event {event_id}");
+    }
+    assert_eq!(
+        context(214, LiveType::Multi).world_bloom_character_id,
+        Some(11)
+    );
+}
