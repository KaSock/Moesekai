+#[test]
+fn shuffle_unit_bonus_search_matches_bruteforce_on_every_path() {
+    let pool = build_pool(&shuffle_unit_cards());
+    let params = SearchParams {
+        top_k: 3,
+        timeout_ms: 0,
+    };
+    let mut cases: Vec<(&str, SearchContext)> = Vec::new();
+    cases.push(("final chapter auto leader", shuffle_multi_ctx(&pool, true)));
+    let mut forced = shuffle_multi_ctx(&pool, true);
+    forced.forced_leader_character_id = Some(9);
+    cases.push(("final chapter forced leader", forced));
+    let mut solo_final = shuffle_multi_ctx(&pool, true);
+    solo_final.live_type = LiveType::Solo;
+    solo_final.skill_scores[0] = [10.0; 6];
+    cases.push(("final chapter solo", solo_final));
+    cases.push(("world bloom chapter", shuffle_multi_ctx(&pool, false)));
+    let mut marathon = shuffle_multi_ctx(&pool, false);
+    marathon.is_world_bloom = false;
+    marathon.event_type = Some(EventType::Marathon);
+    cases.push(("marathon", marathon.clone()));
+    let mut limited = marathon.clone();
+    limited.card_bonus_count_limit = 4;
+    cases.push(("marathon member limit", limited));
+    for target in [ScoreTarget::Bonus, ScoreTarget::Mysekai] {
+        let mut other = marathon.clone();
+        other.target = target;
+        cases.push((
+            if matches!(target, ScoreTarget::Bonus) {
+                "marathon bonus"
+            } else {
+                "marathon mysekai"
+            },
+            other,
+        ));
+    }
+
+    for (name, search_ctx) in cases {
+        let results = search(&pool, &search_ctx, &params);
+        let (brute, _) = brute_force_search(&pool, &search_ctx, &params);
+        assert!(!brute.is_empty(), "{name}: brute force found nothing");
+        assert_eq!(results.len(), brute.len(), "{name}: result length differs");
+        for (rank, (exact, brute)) in results.iter().zip(brute.iter()).enumerate() {
+            assert_eq!(
+                exact.score, brute.score,
+                "{name}: score differs at rank {rank}"
+            );
+            assert_eq!(
+                exact.game_card_set_key(&pool),
+                brute.game_card_set_key(&pool),
+                "{name}: card set differs at rank {rank}",
+            );
+        }
+
+        // 夹具前提：shuffle unit bonus 改变了最优卡组（否则该用例测不到上界）。
+        let mut plain_ctx = search_ctx.clone();
+        plain_ctx.shuffle_unit_bonus = [0; 6];
+        let (plain, _) = brute_force_search(&pool, &plain_ctx, &params);
+        assert!(
+            deck_shuffle_units(&pool, &brute[0].cards) > deck_shuffle_units(&pool, &plain[0].cards),
+            "{name}: shuffle bonus should pull in more units: {:?} ({}) vs {:?} ({})",
+            brute[0].game_card_set_key(&pool),
+            brute[0].score,
+            plain[0].game_card_set_key(&pool),
+            plain[0].score,
+        );
+    }
+}
