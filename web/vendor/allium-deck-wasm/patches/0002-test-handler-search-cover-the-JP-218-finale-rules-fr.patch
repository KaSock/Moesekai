+/// JP #218 eventShuffleUnitBonuses：主卡组 3/4/5 种团 = 10/30/50%。
+const JP_218_SHUFFLE_UNIT_BONUS: [u16; 6] = [0, 0, 0, 10, 30, 50];
+
+fn shuffle_card(
+    game_id: u16,
+    char_id: u8,
+    unit_mask: u8,
+    power: u32,
+    skill: u8,
+    base_bonus: u8,
+    limited_bonus: u8,
+) -> TestCard {
+    TestCard {
+        char_id,
+        attr: char_id % 3,
+        unit_mask,
+        game_id,
+        power,
+        skill: SkillSlot {
+            skill_type: 0,
+            value: skill,
+        },
+        base_bonus,
+        limited_bonus,
+        power_max: power,
+        skill_max: skill,
+    }
+}
+
+/// 高练度卡集中在 LN/MMJ；异团卡略弱，只有计入 shuffle unit bonus 才进最优解。
+/// VS 卡带支援团（21→LN、22→VBS）时仍只计 VIRTUAL SINGER。
+fn shuffle_unit_cards() -> Vec<TestCard> {
+    vec![
+        shuffle_card(801, 1, 1, 60_000, 100, 20, 25),
+        shuffle_card(802, 2, 1, 59_000, 100, 20, 25),
+        shuffle_card(803, 3, 1, 58_000, 90, 20, 25),
+        shuffle_card(805, 5, 2, 59_500, 100, 20, 25),
+        shuffle_card(806, 6, 2, 58_500, 90, 20, 25),
+        shuffle_card(809, 9, 4, 55_000, 95, 20, 25),
+        shuffle_card(813, 13, 8, 54_000, 95, 20, 25),
+        shuffle_card(817, 17, 16, 53_000, 95, 20, 20),
+        shuffle_card(821, 21, 32 | 1, 56_000, 95, 20, 25),
+        shuffle_card(822, 22, 32 | 4, 55_500, 95, 20, 20),
+        shuffle_card(823, 23, 32, 55_000, 95, 20, 15),
+    ]
+}
+
+fn shuffle_multi_ctx(pool: &CardPool, final_chapter: bool) -> SearchContext {
+    let mut search_ctx = ready_ctx(pool, ScoreTarget::Score);
+    search_ctx.is_final_chapter = final_chapter;
+    search_ctx.is_world_bloom = true;
+    search_ctx.event_type = Some(EventType::WorldBloom);
+    search_ctx.live_type = LiveType::Multi;
+    search_ctx.live_skill_order = LiveSkillOrder::Average;
+    search_ctx.best_skill_as_leader = false;
+    search_ctx.skill_scores[1] = [10.0; 6];
+    search_ctx.shuffle_unit_bonus = JP_218_SHUFFLE_UNIT_BONUS;
+    search_ctx
+}
+
+fn deck_shuffle_units(pool: &CardPool, deck: &[CardIdx; DECK_SIZE]) -> u32 {
+    deck.iter()
+        .fold(0u8, |set, &card| {
+            set | context::shuffle_unit_bit(pool.unit_mask_raw(card))
+        })
+        .count_ones()
+}
+
+#[test]
+fn shuffle_unit_bonus_counts_virtual_singers_only_as_virtual_singer() {
+    let pool = build_pool(&shuffle_unit_cards());
+    let mut search_ctx = shuffle_multi_ctx(&pool, true);
+    let deck = |ids: [u16; 5]| {
+        ids.map(|id| {
+            pool.indices()
+                .find(|&card| pool.game_id(card) == id)
+                .expect("card in pool")
+        })
+    };
+    let two_units = deck([801, 802, 821, 822, 823]);
+    let three_units = deck([801, 802, 805, 821, 822]);
+    let four_units = deck([801, 805, 809, 821, 822]);
+    let five_units = deck([801, 805, 809, 813, 817]);
+    let five_with_vs = deck([801, 805, 809, 813, 823]);
+    assert_eq!(search_ctx.shuffle_unit_bonus_for(&pool, &two_units), 0);
+    assert_eq!(search_ctx.shuffle_unit_bonus_for(&pool, &three_units), 10);
+    assert_eq!(search_ctx.shuffle_unit_bonus_for(&pool, &four_units), 30);
+    assert_eq!(search_ctx.shuffle_unit_bonus_for(&pool, &five_units), 50);
+    assert_eq!(search_ctx.shuffle_unit_bonus_for(&pool, &five_with_vs), 50);
+
+    // 加成合计：终章与非终章 WL、普通活动三条精确路径都计入同一档。
+    let with_shuffle = evaluate::resolve_total_bonus(&pool, &search_ctx, &four_units);
+    search_ctx.shuffle_unit_bonus = [0; 6];
+    let without = evaluate::resolve_total_bonus(&pool, &search_ctx, &four_units);
+    assert_eq!(with_shuffle - without, 30.0);
+    for world_bloom in [true, false] {
+        let mut chapter_ctx = shuffle_multi_ctx(&pool, false);
+        chapter_ctx.is_world_bloom = world_bloom;
+        let with_shuffle = evaluate::resolve_total_bonus(&pool, &chapter_ctx, &three_units);
+        chapter_ctx.shuffle_unit_bonus = [0; 6];
+        let without = evaluate::resolve_total_bonus(&pool, &chapter_ctx, &three_units);
+        assert_eq!(with_shuffle - without, 10.0, "world_bloom={world_bloom}");
+    }
+}
