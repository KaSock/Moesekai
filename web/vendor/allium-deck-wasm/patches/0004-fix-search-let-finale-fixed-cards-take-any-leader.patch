+/// 终章只有固定卡：逐个候选队长角色按指定队长求解，按卡组集合归并 Top-K。
+/// 固定卡占满 5 个槽位时队长只能是固定卡之一。
+fn search_final_chapter_fixed_cards(
+    pool: &CardPool,
+    ctx: &SearchContext,
+    params: &SearchParams,
+) -> (Vec<DeckResult>, SearchStats) {
+    let deadline =
+        (params.timeout_ms != 0).then(|| Instant::now() + Duration::from_millis(params.timeout_ms));
+    let fixed_card_chars = ctx
+        .fixed_card_ids
+        .iter()
+        .filter_map(|&game_id| character_of_game_id(pool, game_id))
+        .collect::<Vec<_>>();
+    // 按终章队长潜力排序：先求强队长，后续队长借归并阈值尽早剪枝。
+    let mut leaders = Vec::new();
+    for card in warm_start::sorted_final_chapter_leaders(pool, ctx) {
+        let character_id = pool.char_id(card);
+        if !leaders.contains(&character_id)
+            && (ctx.fixed_card_ids.len() < DECK_SIZE || fixed_card_chars.contains(&character_id))
+        {
+            leaders.push(character_id);
+        }
+    }
+
+    let mut tracker = dfs::TopKTracker::new(
+        params.top_k,
+        pool,
+        matches!(ctx.target, ScoreTarget::Mysekai),
+    );
+    let mut stats = SearchStats::default();
+    for leader in leaders {
+        // timeout_ms == 0 表示不限时，剩余时间耗尽时必须停下而不是传 0。
+        let timeout_ms = match deadline {
+            None => 0,
+            Some(deadline) => {
+                let remaining = deadline
+                    .saturating_duration_since(Instant::now())
+                    .as_millis() as u64;
+                if remaining == 0 {
+                    break;
+                }
+                remaining
+            }
+        };
+        let mut leader_ctx = ctx.clone();
+        leader_ctx.forced_leader_character_id = Some(leader);
+        // 分数不高于已归并第 K 名的卡组进不了结果；减一保留同分卡组交给归并定序。
+        leader_ctx.score_floor = tracker.threshold().saturating_sub(1);
+        let leader_params = SearchParams {
+            top_k: params.top_k,
+            timeout_ms,
+        };
+        let (results, leader_stats) = search_instrumented(pool, &leader_ctx, &leader_params);
+        challenge_search::accumulate_stats(&mut stats, &leader_stats);
+        for result in results {
+            tracker.insert(result);
+        }
+    }
+    (tracker.into_vec(), stats)
+}
