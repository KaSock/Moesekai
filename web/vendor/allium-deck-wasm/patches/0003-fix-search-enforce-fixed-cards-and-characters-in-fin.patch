+/// 终章指定队长而 0 号固定槽（队长位）不是该角色时，改写为等价约束：固定卡改成
+/// 其角色的固定角色（池里该角色只留这张卡），队长角色排到首位，其余固定槽保持原
+/// 相对顺序（池已按该顺序排在最前）。返回保留位图与改写后的上下文。
+fn final_chapter_leader_first(
+    pool: &CardPool,
+    ctx: &SearchContext,
+) -> Option<(Vec<bool>, SearchContext)> {
+    let leader = ctx.forced_leader_character_id?;
+    if final_chapter_slot0_character(pool, ctx)? == leader {
+        return None;
+    }
+    let fixed_card_chars = ctx
+        .fixed_card_ids
+        .iter()
+        .filter_map(|&game_id| character_of_game_id(pool, game_id))
+        .collect::<Vec<_>>();
+    let keep = pool
+        .indices()
+        .map(|card| {
+            !fixed_card_chars.contains(&pool.char_id(card))
+                || ctx.is_fixed_game_id(pool.game_id(card))
+        })
+        .collect::<Vec<_>>();
+    let mut fixed_character_ids = vec![leader];
+    for &character_id in fixed_card_chars.iter().chain(&ctx.fixed_character_ids) {
+        if !fixed_character_ids.contains(&character_id) {
+            fixed_character_ids.push(character_id);
+        }
+    }
+    let mut leader_first = ctx.remap(&keep);
+    leader_first.fixed_card_ids = Vec::new();
+    leader_first.fixed_character_ids = fixed_character_ids;
+    Some((keep, leader_first))
+}
+
+/// 终章 0 号固定槽（队长位）约束的角色；0 号槽无约束时为 `None`。
+fn final_chapter_slot0_character(pool: &CardPool, ctx: &SearchContext) -> Option<u8> {
+    match ctx.fixed_card_at(0) {
+        Some(game_id) => character_of_game_id(pool, game_id),
+        None => ctx.fixed_character_at(0),
+    }
+}
+
+fn character_of_game_id(pool: &CardPool, game_id: u16) -> Option<u8> {
+    pool.indices()
+        .find(|&card| pool.game_id(card) == game_id)
+        .map(|card| pool.char_id(card))
+}
