+/// 终章固定约束夹具：固定卡、固定角色、指定队长同时出现时的一组约束。
+struct FinalChapterConstraint {
+    name: &'static str,
+    fixed_cards: Vec<u16>,
+    fixed_characters: Vec<u8>,
+    leader: Option<u8>,
+}
+
+fn final_chapter_constraint_cards(seed: u64) -> Vec<TestCard> {
+    let mut state = seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1;
+    let mut next = |bound: u32| {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        (state % u64::from(bound)) as u32
+    };
+    // 两张卡的角色覆盖同角色选卡；VS 带支援团时 shuffle 仍只计 VIRTUAL SINGER。
+    let slots: [(u8, u8); 13] = [
+        (1, 1),
+        (1, 1),
+        (2, 1),
+        (5, 2),
+        (5, 2),
+        (6, 2),
+        (9, 4),
+        (13, 8),
+        (13, 8),
+        (17, 16),
+        (21, 32 | 1),
+        (21, 32),
+        (22, 32 | 4),
+    ];
+    slots
+        .iter()
+        .enumerate()
+        .map(|(idx, &(char_id, unit_mask))| {
+            let power = 40_000 + next(20_000);
+            let skill = 60 + next(60) as u8;
+            let limited_bonus = if next(2) == 0 { 0 } else { 20 + next(6) as u8 };
+            TestCard {
+                char_id,
+                attr: next(5) as u8,
+                unit_mask,
+                game_id: 1_000 + idx as u16,
+                power,
+                skill: SkillSlot {
+                    skill_type: 0,
+                    value: skill,
+                },
+                base_bonus: next(26) as u8,
+                limited_bonus,
+                power_max: power,
+                skill_max: skill,
+            }
+        })
+        .collect()
+}
+
+/// 按建池口径排列并补齐约束：指定队长未被覆盖时追加为固定角色（同
+/// `validate_fixed_constraints`），固定槽卡按槽序排在池首（同 `sort_and_gather`）。
+fn final_chapter_constraint_setup(
+    cards: &[TestCard],
+    constraint: &FinalChapterConstraint,
+    target: ScoreTarget,
+    live_type: LiveType,
+) -> (CardPool, SearchContext) {
+    let mut fixed_character_ids = constraint.fixed_characters.clone();
+    if let Some(leader) = constraint.leader {
+        let covered = fixed_character_ids.contains(&leader)
+            || cards.iter().any(|card| {
+                card.char_id == leader && constraint.fixed_cards.contains(&card.game_id)
+            });
+        if !covered {
+            fixed_character_ids.push(leader);
+        }
+    }
+    let rank = |card: &TestCard| {
+        constraint
+            .fixed_cards
+            .iter()
+            .position(|&id| id == card.game_id)
+            .or_else(|| {
+                fixed_character_ids
+                    .iter()
+                    .position(|&id| id == card.char_id)
+                    .map(|pos| constraint.fixed_cards.len() + pos)
+            })
+            .unwrap_or(usize::MAX)
+    };
+    let mut sorted = cards.to_vec();
+    sorted.sort_by_key(|card| rank(card));
+    let pool = build_pool(&sorted);
+    let mut search_ctx = ready_ctx(&pool, target);
+    search_ctx.is_final_chapter = true;
+    search_ctx.is_world_bloom = true;
+    search_ctx.event_type = Some(EventType::WorldBloom);
+    search_ctx.live_type = live_type;
+    search_ctx.live_skill_order = LiveSkillOrder::Average;
+    search_ctx.best_skill_as_leader = false;
+    search_ctx.skill_scores = [[10.0; 6]; 3];
+    search_ctx.shuffle_unit_bonus = JP_218_SHUFFLE_UNIT_BONUS;
+    for (dense, card) in sorted.iter().enumerate() {
+        search_ctx.leader_honor_bonus[dense] = if card.game_id % 3 == 0 { 5 } else { 0 };
+        search_ctx.leader_limit_bonus[dense] = if card.limited_bonus > 0 { 20 } else { 0 };
+    }
+    // 终章支援卡组按队长角色区分，且远大于按 world_bloom_character_id 建的回退卡组。
+    search_ctx.support_deck = SupportDeck {
+        cards: vec![(9_001, 1.0), (9_002, 0.5)],
+        count: 2,
+    };
+    search_ctx.support_decks_by_character = (0..=26u8)
+        .map(|leader| {
+            let mut support = sorted
+                .iter()
+                .filter(|card| {
+                    card.char_id != leader && (card.game_id + u16::from(leader)) % 3 == 0
+                })
+                .take(5)
+                .enumerate()
+                .map(|(rank, card)| (card.game_id, 6.0 - rank as f64 * 0.5))
+                .collect::<Vec<_>>();
+            support.push((9_100 + u16::from(leader), 4.0 + f64::from(leader % 4)));
+            support.push((9_200 + u16::from(leader), 3.5));
+            support.sort_by(|left, right| right.1.total_cmp(&left.1));
+            SupportDeck {
+                cards: support,
+                count: 4,
+            }
+        })
+        .collect();
+    // 同 `build_search_context`：属性加成上界 + 回退卡组 + 各队长卡组中的最大者。
+    let top_sum = |deck: &SupportDeck| {
+        deck.cards
+            .iter()
+            .take(deck.count as usize)
+            .map(|(_, bonus)| *bonus)
+            .sum::<f64>()
+    };
+    search_ctx.extra_bonus_ub = top_sum(&search_ctx.support_deck).ceil() as u32
+        + search_ctx
+            .support_decks_by_character
+            .iter()
+            .map(top_sum)
+            .fold(0.0_f64, f64::max)
+            .ceil() as u32;
+    search_ctx.fixed_card_ids = constraint.fixed_cards.clone();
+    search_ctx.fixed_character_ids = fixed_character_ids;
+    search_ctx.forced_leader_character_id = constraint.leader;
+    (pool, search_ctx)
+}
+
+/// 队长位规则：指定队长时队长必须是该角色，否则 0 号固定槽即队长位。
+fn final_chapter_leader_allowed(pool: &CardPool, ctx: &SearchContext, leader: CardIdx) -> bool {
+    match ctx.forced_leader_character_id {
+        Some(character_id) => pool.char_id(leader) == character_id,
+        None => {
+            ctx.fixed_card_at(0)
+                .is_none_or(|game_id| pool.game_id(leader) == game_id)
+                && ctx
+                    .fixed_character_at(0)
+                    .is_none_or(|character_id| pool.char_id(leader) == character_id)
+        }
+    }
+}
+
+fn final_chapter_constraints_hold(
+    pool: &CardPool,
+    ctx: &SearchContext,
+    deck: &[CardIdx; DECK_SIZE],
+) -> bool {
+    final_chapter_leader_allowed(pool, ctx, deck[0])
+        && ctx
+            .fixed_card_ids
+            .iter()
+            .all(|&game_id| deck.iter().any(|&card| pool.game_id(card) == game_id))
+        && ctx
+            .fixed_character_ids
+            .iter()
+            .all(|&character_id| deck.iter().any(|&card| pool.char_id(card) == character_id))
+}
+
+/// 与槽位实现无关的暴力解：枚举全部角色唯一的五卡集合与每个合法队长，按集合取最优排列。
+fn final_chapter_constrained_brute_scores(
+    pool: &CardPool,
+    ctx: &SearchContext,
+    top_k: usize,
+) -> Vec<u64> {
+    let count = pool.count();
+    let mut set_scores = Vec::new();
+    let mut picked = [0usize; DECK_SIZE];
+    fn walk(
+        pool: &CardPool,
+        ctx: &SearchContext,
+        depth: usize,
+        start: usize,
+        count: usize,
+        picked: &mut [usize; DECK_SIZE],
+        set_scores: &mut Vec<u64>,
+    ) {
+        if depth == DECK_SIZE {
+            let cards = picked.map(|dense| CardIdx::new(dense as u16));
+            let mut best = None;
+            for leader_pos in 0..DECK_SIZE {
+                let mut deck = cards;
+                deck.swap(0, leader_pos);
+                deck[1..].sort_unstable_by_key(|card| card.raw());
+                if !final_chapter_constraints_hold(pool, ctx, &deck) {
+                    continue;
+                }
+                if let Some(score) = evaluate::leaf_evaluate_checked(pool, ctx, &deck) {
+                    best = best.max(Some(score));
+                }
+            }
+            if let Some(score) = best {
+                set_scores.push(score);
+            }
+            return;
+        }
+        for dense in start..count {
+            let card = CardIdx::new(dense as u16);
+            if picked[..depth].iter().any(|&other| {
+                let other = CardIdx::new(other as u16);
+                pool.char_id(other) == pool.char_id(card)
+                    || pool.game_id(other) == pool.game_id(card)
+            }) {
+                continue;
+            }
+            picked[depth] = dense;
+            walk(pool, ctx, depth + 1, dense + 1, count, picked, set_scores);
+        }
+    }
+    walk(pool, ctx, 0, 0, count, &mut picked, &mut set_scores);
+    set_scores.sort_unstable_by(|left, right| right.cmp(left));
+    set_scores.truncate(top_k);
+    set_scores
+}
+
+#[test]
+fn final_chapter_search_keeps_fixed_cards_characters_and_forced_leader() {
+    let params = SearchParams {
+        top_k: 3,
+        timeout_ms: 0,
+    };
+    let mut constrained_optimum_differs = 0usize;
+    for seed in 1..=40u64 {
+        let cards = final_chapter_constraint_cards(seed);
+        let pick = |offset: u64| cards[((seed * 7 + offset * 5) % cards.len() as u64) as usize];
+        let x = pick(0);
+        let y = cards
+            .iter()
+            .copied()
+            .find(|card| card.char_id != x.char_id && card.game_id > x.game_id)
+            .unwrap_or(cards[0]);
+        let leader = [2u8, 6, 9, 17, 22][(seed % 5) as usize];
+        let leader_card = cards
+            .iter()
+            .copied()
+            .find(|card| card.char_id == leader)
+            .expect("leader character in pool");
+        let other_char = [1u8, 13, 21][(seed % 3) as usize];
+        let x_not_leader = if x.char_id == leader { y } else { x };
+        let constraints = vec![
+            FinalChapterConstraint {
+                name: "fixed card",
+                fixed_cards: vec![x.game_id],
+                fixed_characters: Vec::new(),
+                leader: None,
+            },
+            FinalChapterConstraint {
+                name: "two fixed cards",
+                fixed_cards: vec![x.game_id, y.game_id],
+                fixed_characters: Vec::new(),
+                leader: None,
+            },
+            FinalChapterConstraint {
+                name: "two fixed characters",
+                fixed_cards: Vec::new(),
+                fixed_characters: vec![other_char, 5],
+                leader: None,
+            },
+            FinalChapterConstraint {
+                name: "fixed card and fixed character",
+                fixed_cards: vec![x_not_leader.game_id],
+                fixed_characters: vec![leader],
+                leader: None,
+            },
+            FinalChapterConstraint {
+                name: "forced leader and fixed character",
+                fixed_cards: Vec::new(),
+                fixed_characters: vec![if other_char == leader { 5 } else { other_char }],
+                leader: Some(leader),
+            },
+            FinalChapterConstraint {
+                name: "forced leader and fixed card",
+                fixed_cards: vec![x_not_leader.game_id],
+                fixed_characters: Vec::new(),
+                leader: Some(leader),
+            },
+            FinalChapterConstraint {
+                name: "forced leader covered by the second fixed card",
+                fixed_cards: vec![x_not_leader.game_id, leader_card.game_id],
+                fixed_characters: Vec::new(),
+                leader: Some(leader),
+            },
+        ];
+        for constraint in &constraints {
+            for (target, live_type) in [
+                (ScoreTarget::Score, LiveType::Multi),
+                (ScoreTarget::Score, LiveType::Solo),
+                (ScoreTarget::Mysekai, LiveType::Multi),
+            ] {
+                let name = format!("seed {seed} {} {target:?} {live_type:?}", constraint.name);
+                let (pool, search_ctx) =
+                    final_chapter_constraint_setup(&cards, constraint, target, live_type);
+                let brute =
+                    final_chapter_constrained_brute_scores(&pool, &search_ctx, params.top_k);
+                assert!(!brute.is_empty(), "{name}: no legal deck");
+                let results = search(&pool, &search_ctx, &params);
+                let scores = results
+                    .iter()
+                    .map(|result| result.score)
+                    .collect::<Vec<_>>();
+                assert_eq!(scores, brute, "{name}: Top-K scores differ");
+                for result in &results {
+                    assert!(
+                        final_chapter_constraints_hold(&pool, &search_ctx, &result.cards),
+                        "{name}: {:?} breaks a fixed constraint",
+                        result.game_card_set_key(&pool),
+                    );
+                    assert_eq!(
+                        evaluate::leaf_evaluate_checked(&pool, &search_ctx, &result.cards),
+                        Some(result.score),
+                        "{name}: reported score differs from the deck",
+                    );
+                }
+
+                let mut free_ctx = search_ctx.clone();
+                free_ctx.fixed_card_ids.clear();
+                free_ctx.fixed_character_ids.clear();
+                free_ctx.forced_leader_character_id = None;
+                if final_chapter_constrained_brute_scores(&pool, &free_ctx, 1)[0] > brute[0] {
+                    constrained_optimum_differs += 1;
+                }
+            }
+        }
+    }
+    // 夹具前提：多数约束确实把最优解从无约束最优解上拉开。
+    assert!(
+        constrained_optimum_differs > 400,
+        "constraints rarely bind: {constrained_optimum_differs}"
+    );
+}
